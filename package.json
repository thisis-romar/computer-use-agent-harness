{
  "name": "computer-use-agent-harness",
  "version": "0.1.0",
  "description": "A hardened MCP computer-use server with policy controls, telemetry, region capture, zoom-aware screenshots, and sidecar-ready native desktop automation backends.",
  "type": "module",
  "bin": {
    "computer-use-agent-harness": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": "Emblem Projects <admin+github@emblemprojects.com>",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "LICENSE-COMMERCIAL.md",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "smoke": "node dist/index.js --self-test",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "computer-use",
    "desktop-automation",
    "ai-agents",
    "typescript",
    "agent-harness",
    "accessibility",
    "screen-capture",
    "automation"
  ],
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.3",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.7"
  }
}
