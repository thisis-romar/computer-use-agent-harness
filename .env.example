# Transport: stdio | http
CUA_TRANSPORT=stdio
# Port for the HTTP transport (when CUA_TRANSPORT=http)
CUA_HTTP_PORT=3099

# Backend selection: auto | windows | browser | accessibility | dry-run
CUA_BACKEND=auto

# Simulate mutating actions (recommended while evaluating an agent)
CUA_DRY_RUN=false

# Highest risk tier the policy will permit: safe | low | medium | high | critical
CUA_MAX_RISK_TIER=medium
# Enforcement posture for tier-ceiling violations: enforce | warn | confirm
CUA_POLICY_MODE=enforce

# Screenshot capture tuning
CUA_SCREENSHOT_DELAY_MS=150
CUA_MAX_IMAGE_LONG_EDGE=1568
CUA_MAX_IMAGE_PIXELS=1205862

# Telemetry
CUA_TELEMETRY_ENABLED=true
# CUA_TELEMETRY_PATH=traces/actions-YYYY-MM-DD.jsonl
CUA_REDACT_PAYLOADS=true

# Logging (stderr only): debug | info | warn | error
CUA_LOG_LEVEL=info
